    ".juno_task/scripts/tests/test_managed_agent_runner.py",
    ".juno_task/scripts/tests/test_merge_queue.py",
    ".juno_task/scripts/tests/test_metadata_controller.py",
    ".juno_task/scripts/tests/test_operation_snapshot.py",
    ".juno_task/scripts/tests/test_release_train.py",
    ".juno_task/scripts/tests/test_risk_policy.py",
    ".juno_task/scripts/tests/test_task_workspace.py",
    ".juno_task/scripts/tests/test_task_workspace_decisions.py",
    ".juno_task/scripts/watch_progress.py",
    ".juno_task/scripts/wiki_lint.py",
    ".juno_task/scripts/workflow_runner.sh",
    ".juno_task/scripts/worktree_hydration.py",
    ".juno_task/wiki",
    ".pi/skills/yylo-seo",
    "AGENTS.md",
    "README.md",
    "juno-benchmark",
    "juno-code",
    "scripts"
  ],
  "selectable_paths": [
    "frontend",
    "juno_kanban"
  ],
  "controller_private_paths": [
    ".juno_task/artifacts",
    ".juno_task/ledger",
    ".juno_task/logs",
    ".juno_task/receipts",
    ".juno_task/specs",
    ".juno_task/state",
    ".juno_task/task-scopes",
    ".juno_task/tasks",
    ".juno_task/tasks.md",
    ".juno_task/workflows"
  ],
  "focused_validation": [
    {
      "id": "task-workspace-decisions",
      "cwd": ".juno_task/scripts/tests",
      "timeout_seconds": 30,
      "max_output_bytes": 32768,
      "argv": [
        "python3",
        "test_task_workspace_decisions.py"
      ]
    },
    {
      "id": "task-workspace-adapter-canary",
      "cwd": ".juno_task/scripts/tests",
      "timeout_seconds": 60,
      "max_output_bytes": 32768,
      "argv": [
        "python3",
        "test_task_workspace.py",
        "TaskWorkspaceTests.test_finish_queues_clean_committed_tip_without_merging_or_cleanup"
      ]
    },
    {
      "id": "integration-workspace",
      "cwd": "juno-code",
      "timeout_seconds": 900,
      "max_output_bytes": 32768,
      "argv": [
        "npm",
        "test",
        "--",
        "src/utils/__tests__/integration-workspace.test.ts",
        "src/cli/__tests__/task-command.test.ts",
        "src/cli/__tests__/integration-command.test.ts"
      ]
    },
    {
      "id": "script-installer",
      "cwd": "juno-code",
      "timeout_seconds": 900,
      "max_output_bytes": 32768,
      "argv": [
        "npm",
        "test",
        "--",
        "src/utils/__tests__/script-installer.test.ts"
      ],
      "resource": {
        "id": "yylo-real-git-managed-install",
        "lock_path": "/tmp/yylo-focused-real-git-managed-install.lock",
        "wait_timeout_seconds": 1200
      }
    },
    {
      "id": "root-scripts-telemetry",
      "cwd": "scripts/tests",
      "timeout_seconds": 120,
      "max_output_bytes": 32768,
      "argv": [
        "python3",
        "agent-session-telemetry.test.py"
      ]
    }
  ],
  "full_suite_validation": {
    "id": "full-suite",
    "cwd": "juno-code",
    "timeout_seconds": 3600,
    "max_output_bytes": 65536,
    "argv": [
      "npm",
      "test"
    ]
  },
  "validation_profiles": [
    {
      "id": "benchmark-suite",
      "path_roots": [
        "juno-benchmark"
      ],
      "commands": [
        {
          "id": "benchmark-test",
          "cwd": "juno-benchmark",
          "argv": [
            "npm",
            "test"
          ],
          "timeout_seconds": 900,
          "max_output_bytes": 32768,
          "input_paths": [
            "juno-benchmark/package.json",
            "juno-benchmark/package-lock.json",
            "juno-benchmark/tsconfig.json",
            "juno-benchmark/vitest.config.ts",
            "juno-benchmark/src",
            "juno-benchmark/test",
            "juno-benchmark/boundary",
            "juno-benchmark/scripts",
            "juno-benchmark/workflows"
          ]
        },
        {
          "id": "benchmark-typecheck",
          "cwd": "juno-benchmark",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 900,
          "max_output_bytes": 32768,
          "input_paths": [
            "juno-benchmark/package.json",
            "juno-benchmark/package-lock.json",
            "juno-benchmark/tsconfig.json",
            "juno-benchmark/src"
          ]
        },
        {
          "id": "benchmark-build",
          "cwd": "juno-benchmark",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 900,
          "max_output_bytes": 32768,
          "input_paths": [
            "juno-benchmark/package.json",
            "juno-benchmark/package-lock.json",
            "juno-benchmark/tsconfig.json",
            "juno-benchmark/tsup.config.ts",
            "juno-benchmark/src"
          ]
        }
      ]
    }
  ],
  "documentation_validation": {
    "schema_version": "juno_documentation_validation_policy.v1",
    "inert_exact_files": [
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "inert_roots": [
      ".juno_task/wiki"
    ],
    "active_exact_files": [
