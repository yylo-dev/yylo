      "juno-code/README.md",
      "juno-benchmark/README.md"
    ],
    "active_roots": [
      "docs",
      "juno-code/docs",
      "juno-benchmark/docs"
    ],
    "active_name_patterns": [
      "(^|/)(CHANGELOG|RELEASE_NOTES)(\\.[^/]*)?$",
      "(^|/)MIGRATION[^/]*\\.md$"
    ],
    "public_identities": [
